# --- Web + worker ---
# Must be reachable from the ZooWork sandbox (the agent curls /api/agent/ctx/<token>). Locally: a cloudflared/ngrok tunnel URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Worker + scripts: Supabase *session* pooler (port 5432). Web: *transaction* pooler (port 6543) via DATABASE_URL_WEB.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/favie
DATABASE_URL_WEB=
# openssl rand -base64 32 — encrypts per-restaurant data-access keys at rest. Changing it orphans saved keys.
FAVIE_ENCRYPTION_KEY=

# Supabase (Auth, email confirmation ON). Server uses the secret key; add the publishable key if a browser client is ever needed.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# In Supabase → Auth → URL Configuration add <APP_URL>/auth/confirm to Redirect URLs.

# Stripe — $299/mo recurring price, pay at signup, refunds handled manually within 30 days
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_PORTAL_CONFIG_ID=bpc_...

# ZooWork organization service token (server-side only). Bootstrap value: a key saved by a sysadmin in /admin
# (stored encrypted in app_settings) takes precedence over this one.
ZOOWORK_API_KEY=zct_...
# Org skill id of `favie-ops`. First publish (npx tsx scripts/publish-skill.ts) prints it; every teammate must use the SAME id.
FAVIE_OPS_SKILL_ID=skl_...

# Zoodata MCP. Restaurants without their own saved key get deterministic sample data.
ZOODATA_MCP_URL=https://api.zoodata.ai/mcp-restaurant
# Set to `mock` to force sample data for everyone (never do this against the shared dev database).
# ZOODATA_MODE=mock

# Dev only
# FAVIE_SKIP_BILLING=1

# --- M0 spike only (optional) ---
# M0_KEEP_AGENT=1

# Comma-separated sysadmin logins (kevin_z@srp.one is always an admin)
ADMIN_EMAILS=
